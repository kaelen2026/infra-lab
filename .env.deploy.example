# infra-lab deployment compose example.
# Copy to `.env.deploy` and pass with:
#   docker compose --env-file .env.deploy -f docker-compose.deploy.yml up -d --build

IMAGE_TAG=local
NPM_REGISTRY=https://registry.npmjs.org

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
POSTGRES_PORT=5432

# Public origins seen by browsers. Use HTTPS in real deployments.
BETTER_AUTH_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
VITE_API_URL=https://api.example.com
TRUSTED_ORIGINS=https://h5.example.com
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1

# Generate with `openssl rand -hex 32`; keep these different.
OTP_SECRET=replace-me-with-a-long-random-hex-string
BETTER_AUTH_SECRET=replace-me-with-another-long-random-hex-string

API_PORT=3001
WEB_PORT=3000
H5_PORT=3002

MAX_REQUEST_BODY_BYTES=10485760
SLOW_REQUEST_MS=1000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Optional APNS.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=
# APNS_PRIVATE_KEY_PATH=
# APNS_PRODUCTION=false

# Optional bot profile (`--profile bot`).
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_DOMAIN=
# INFRA_LAB_BOT_GITHUB_REPO=
# INFRA_LAB_BOT_APP_ID=
# INFRA_LAB_BOT_INSTALLATION_ID=
# INFRA_LAB_BOT_PRIVATE_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
