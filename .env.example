# ─────────────────────────────────────────────────────────────
# infra-lab — phone + OTP auth
# Copy to `.env` and adjust. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Postgres (long-term data: user / profile / device / refresh_token / login_event)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app

# Redis (short-term data: otp / attempt / cooldown / rate-limit / lock)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# HMAC secret used to hash OTP codes before they touch Redis.
# Generate with: openssl rand -hex 32
OTP_SECRET=replace-me-with-a-long-random-hex-string

# Better Auth session signing secret. Generate with: openssl rand -hex 32
# Key separation: in production this MUST be set and MUST differ from OTP_SECRET
# (boot fails otherwise). In dev it falls back to OTP_SECRET when unset.
BETTER_AUTH_SECRET=replace-me-with-another-long-random-hex-string
BETTER_AUTH_URL=http://localhost:3000

# Cookie domain / security. In production set COOKIE_SECURE=true behind HTTPS.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Number of trusted reverse proxies that append X-Forwarded-For in front of the API.
# The client IP (per-IP OTP rate limiting) is read this many entries from the RIGHT of
# the XFF list, so a client-forged leftmost entry can't rotate fake IPs. 0 (default) =
# XFF untrusted; set it to your real hop count only behind proxies you control.
TRUSTED_PROXY_COUNT=0

# Runtime environment. When "production", boot-time guardrails apply: OTP_DEBUG_RETURN_CODE
# must be off, and BETTER_AUTH_SECRET must be set and differ from OTP_SECRET.
# NODE_ENV=development

# Set to expose the generated code in the OTP request response (dev only — never in prod).
OTP_DEBUG_RETURN_CODE=true
