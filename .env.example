# ─────────────────────────────────────────────────────────────
# infra-lab — phone + OTP auth
# Copy to `.env` and adjust. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Postgres (long-term data: user / profile / device / refresh_token / login_event)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app

# Redis (short-term data: otp / attempt / cooldown / rate-limit / lock)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# HMAC secret used to hash OTP codes before they touch Redis.
# Generate with: openssl rand -hex 32
OTP_SECRET=replace-me-with-a-long-random-hex-string

# Better Auth session signing secret. Generate with: openssl rand -hex 32
# Key separation: in production this MUST be set and MUST differ from OTP_SECRET
# (boot fails otherwise). In dev it falls back to OTP_SECRET when unset.
BETTER_AUTH_SECRET=replace-me-with-another-long-random-hex-string
BETTER_AUTH_URL=http://localhost:3000

# Extra browser origins allowed to call the API cross-origin (comma-separated), on top
# of BETTER_AUTH_URL. h5 runs on its own origin (:3002) and reuses the cookie transport,
# so it must be trusted for both CORS and Better Auth. Defaults to the h5 dev origin;
# set to your real h5 origin(s) in production.
TRUSTED_ORIGINS=http://localhost:3002

# Cookie domain / security. In production set COOKIE_SECURE=true behind HTTPS.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Admin allowlist for the web management console (/admin). Comma-separated phone
# numbers (E.164); a user whose phone is listed can reach /admin/*, everyone else
# gets 403. Empty (the default) means no admins — the console is closed.
ADMIN_PHONES=

# Number of trusted reverse proxies that append X-Forwarded-For in front of the API.
# The client IP (per-IP OTP rate limiting) is read this many entries from the RIGHT of
# the XFF list, so a client-forged leftmost entry can't rotate fake IPs. 0 (default) =
# XFF untrusted; set it to your real hop count only behind proxies you control.
# Must be > 0 in production: otherwise the client IP collapses to a constant and the
# per-IP OTP quota degrades into one global bucket, so the API refuses to boot.
TRUSTED_PROXY_COUNT=0

# Runtime environment. When "production", boot-time guardrails apply: OTP_DEBUG_RETURN_CODE
# must be off, BETTER_AUTH_SECRET must be set and differ from OTP_SECRET, COOKIE_SECURE
# must be true, and TRUSTED_PROXY_COUNT must be > 0.
# NODE_ENV=development

# Set to expose the generated code in the OTP request response (dev only — never in prod).
OTP_DEBUG_RETURN_CODE=true

# Local directory for timeline image uploads (first-cut storage; swap for object
# storage later). Relative paths resolve against the API cwd (apps/api). Served
# read-only from GET /uploads/:name. Defaults to .uploads (gitignored).
# UPLOADS_DIR=.uploads

# Global request-body ceiling in bytes. A larger body is rejected with 413 before any
# handler buffers it. Must stay above the timeline image upload limit (8 MiB) plus
# multipart overhead. Defaults to 10 MiB.
# MAX_REQUEST_BODY_BYTES=10485760

# A successful request slower than this many ms is logged at warn (slow: true) instead
# of info, surfacing latency regressions without a metrics backend. 0 disables it.
# Defaults to 1000.
# SLOW_REQUEST_MS=1000

# Coarse per-client request throttle (transport-level guardrail). At most RATE_LIMIT_MAX
# requests per client IP per RATE_LIMIT_WINDOW_SECONDS window, on every endpoint except
# the /health and /ready probes. Complements the fine-grained per-phone/per-IP OTP quotas
# (which still apply on top). Relies on the same trusted client-IP resolution as OTP, so
# set TRUSTED_PROXY_COUNT correctly behind a proxy or the bucket collapses to one global
# counter. Set RATE_LIMIT_MAX=0 to disable. Defaults: 120 requests / 60 s.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────
# APNS (Apple Push Notification service) — push to the iOS client. OPTIONAL:
# leave unset and push is simply disabled. Token-based (.p8) provider auth. If ANY
# APNS_* is set, the API requires the full set (KEY_ID + TEAM_ID + BUNDLE_ID + exactly
# one private-key source), else it refuses to boot. Get the key from the Apple Developer
# portal (Keys → APNs). NEVER commit the real .p8 or key id.
# ─────────────────────────────────────────────────────────────
# APNS_KEY_ID=ABCDE12345
# APNS_TEAM_ID=A1B2C3D4E5
# APNS_BUNDLE_ID=ai.deeplang.infra.ios
# Inline .p8 PEM (\n-escaped) OR a file path — set exactly one:
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APNS_PRIVATE_KEY_PATH=./AuthKey_ABCDE12345.p8
# true → api.push.apple.com (prod), false/default → api.sandbox.push.apple.com.
# APNS_PRODUCTION=false
