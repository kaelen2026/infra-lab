{
  "name": "@infra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "deploy:worker": "wrangler deploy",
    "build:worker:dryrun": "wrangler deploy --dry-run --outdir dist-worker",
    "clean": "rm -rf dist dist-worker"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@infra/auth": "workspace:*",
    "@infra/db": "workspace:*",
    "@infra/env": "workspace:*",
    "@infra/redis": "workspace:*",
    "@infra/shared": "workspace:*",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "tsx": "4.23.12",
    "wrangler": "4.125.0"
  }
}
