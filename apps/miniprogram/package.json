{
  "name": "@infra/miniprogram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "infra-lab 微信小程序端:手机号 + OTP 登录(platform=weapp,Bearer + refresh),复用 @infra/sdk;传输走 wx.request,token 存 wx storage。",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
