@import "tokens.generated.wxss";

page {
  background: var(--background);
  color: var(--foreground);
  font-size: 30rpx;
}

.page {
  padding: 48rpx 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
}

.field {
  height: 92rpx;
  padding: 0 28rpx;
  background: var(--card);
  border: 1rpx solid var(--input);
  border-radius: var(--radius);
  margin-bottom: 24rpx;
}

.primary {
  background: var(--primary);
  color: var(--primary-foreground);
  border-radius: var(--radius);
}

/* <button> applies `button-hover` while pressed; mirror the native pressed state. */
.primary.button-hover {
  background: var(--primary-deep);
  color: var(--primary-foreground);
}

.link {
  color: var(--primary);
  background: transparent;
  font-size: 28rpx;
}

.error {
  color: var(--destructive);
  font-size: 26rpx;
  margin-top: 20rpx;
}
