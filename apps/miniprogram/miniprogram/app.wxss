page {
  --accent: #0b6cff;
  --ink: #1a1a1f;
  --muted: #8a8a92;
  --line: #e5e5ea;
  background: #f5f5f7;
  color: var(--ink);
  font-size: 30rpx;
}

.page {
  padding: 48rpx 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
}

.field {
  height: 92rpx;
  padding: 0 28rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.primary {
  background: var(--accent);
  color: #fff;
  border-radius: 16rpx;
}

.link {
  color: var(--accent);
  background: transparent;
  font-size: 28rpx;
}

.error {
  color: #e5484d;
  font-size: 26rpx;
  margin-top: 20rpx;
}
