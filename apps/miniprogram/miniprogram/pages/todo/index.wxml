<view class="page">
  <view class="topbar">
    <text class="title">待办</text>
    <text class="link" bindtap="goProfile">我的</text>
  </view>

  <view class="row">
    <input class="field grow" placeholder="新增待办" value="{{newTitle}}" bindinput="onTitleInput" confirm-type="done" bindconfirm="add" />
    <button class="primary mini" loading="{{busy}}" bindtap="add">添加</button>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:if="{{todos.length === 0}}">还没有待办</view>

  <view class="item" wx:for="{{todos}}" wx:key="id">
    <view class="check {{item.completed ? 'done' : ''}}" data-id="{{item.id}}" bindtap="toggle">
      <text class="tick" wx:if="{{item.completed}}">✓</text>
    </view>
    <text class="label {{item.completed ? 'struck' : ''}}">{{item.title}}</text>
    <text class="del" data-id="{{item.id}}" bindtap="remove">删除</text>
  </view>
</view>
