.topbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.topbar .title {
  margin-bottom: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.grow {
  flex: 1;
  margin-bottom: 0;
}
.mini {
  flex: none;
  min-width: 140rpx;
}

.empty {
  color: var(--muted-foreground);
  text-align: center;
  padding: 80rpx 0;
}

.item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}
.check {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--muted-foreground);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check.done {
  background: var(--primary);
  border-color: var(--primary);
}
.tick {
  color: var(--primary-foreground);
  font-size: 28rpx;
}
.label {
  flex: 1;
}
.label.struck {
  color: var(--muted-foreground);
  text-decoration: line-through;
}
.del {
  color: var(--destructive);
  font-size: 26rpx;
}
