<view class="page">
  <view class="title">手机号登录</view>
  <view class="subtitle">未注册的手机号将自动创建账号</view>

  <block wx:if="{{step === 'phone'}}">
    <input class="field" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    <button class="primary" loading="{{busy}}" bindtap="requestCode">获取验证码</button>
  </block>

  <block wx:else>
    <input class="field" type="number" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
    <button class="primary" loading="{{busy}}" bindtap="verify">登录</button>
    <button class="link" disabled="{{cooldown > 0}}" bindtap="requestCode">
      {{cooldown > 0 ? cooldown + 's 后重新发送' : '重新发送验证码'}}
    </button>
  </block>

  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
