.card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 8rpx 28rpx;
  margin-bottom: 40rpx;
}
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.line:last-child {
  border-bottom: none;
}
.k {
  color: var(--muted-foreground);
}
.v {
  color: var(--foreground);
}
.v-input {
  text-align: right;
  flex: 1;
  margin-left: 40rpx;
}
.danger {
  margin-top: 48rpx;
  color: var(--destructive);
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
}
