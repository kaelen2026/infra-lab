# Copy to `keystore.properties` (gitignored) to sign release builds with a real key.
# Without this file, release builds fall back to the debug signing key (installable
# locally, but NOT suitable for distribution). Generate a key with:
#   keytool -genkeypair -v -keystore release.jks -alias infra -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.jks
storePassword=changeme
keyAlias=infra
keyPassword=changeme
