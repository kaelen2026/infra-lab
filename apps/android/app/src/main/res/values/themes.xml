<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Compose Material 3 theme drives the real colors at runtime (see
      ui/theme/Theme.kt). This base theme only owns the pre-Compose window
      background shown at launch / behind the system bars; @color/window_background
      is generated from @infra/design and switches day/night via values-night.
    -->
    <style name="Theme.Infra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
