export function codeDescription(phone: string, minutes: number): string {
  return "验证码已发送至 {phone}，{minutes} 分钟内有效。".replace("{phone}", phone).replace("{minutes}", `${minutes}`);
}

export function resendCooldown(seconds: number): string {
  return "{seconds}s 后重新发送".replace("{seconds}", `${seconds}`);
}

export function invalidCodeRemaining(base: string, remaining: number): string {
  return "{base}还可尝试 {remaining} 次。".replace("{base}", base).replace("{remaining}", `${remaining}`);
}
