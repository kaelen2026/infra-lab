{
  "name": "@infra/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "infra-lab 终端客户端:手机号 + OTP 登录,把会话(Bearer + refresh)持久化到本地凭据文件,后续命令复用。",
  "bin": {
    "infra-lab": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@infra/sdk": "workspace:*",
    "@infra/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.22.4"
  }
}
