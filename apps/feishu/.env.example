# apps/feishu 运行时环境变量。复制为 apps/feishu/.env 后填写。
# 这些是 bot 专属的飞书 / GitHub / LLM 凭证，与仓库根 .env（Postgres/Redis/auth）
# 分开管理：bot 无 DB/Redis 依赖。schema/校验见 @infra/env/feishu，入口
# loadFeishuEnv() 从本目录加载 .env（缺变量不报错，按端各自降级）。

# ─── 飞书应用鉴权（入站长连接 + 出站 API 共用）───
# 开发者后台「凭证与基础信息」里拿。SDK 用这两个自动换 tenant_access_token。
LARK_APP_ID=
LARK_APP_SECRET=

# 群聊里判断「这条消息有没有 @ 到 bot」用的 bot open_id（ou_xxx）。
# 不配的话群聊消息一律不放行（私聊不受影响）。跑 `pnpm --filter @infra/feishu whoami` 获取。
FEISHU_BOT_OPEN_ID=

# 飞书域：国内版留空或填 Feishu；国际版（Lark）填 Lark。
LARK_DOMAIN=Feishu

# ─── 派发到本仓库的 infra-lab-bot workflow（workflow_dispatch 触发 infra-lab-bot.yml）───
# 这是接待链路的最后一步落点（index.ts 装配 createBotDispatchHandler）。
# 渲染好的 task 作为 workflow 的 `prompt` 输入透传，原消息 message_id 作为
# `feishu_message_id` 输入。workflow 跑完由 .github/scripts/feishu-reply.mjs 把结果
# 回帖到同一飞书 thread（闭环）——这一步在 GitHub 侧需要仓库 secrets
# LARK_APP_ID / LARK_APP_SECRET（与本文件这两个同值）。
#
# INFRA_LAB_BOT_GITHUB_REPO：infra-lab-bot.yml 所在仓库（owner/repo），**必填**。
# INFRA_LAB_BOT_GITHUB_REF：触发的分支，默认 main。
INFRA_LAB_BOT_GITHUB_REPO=kaelen2026/infra-lab
INFRA_LAB_BOT_GITHUB_REF=main

# 鉴权（二选一，优先级：静态 token > App 换发）：
#
# 方式 A（推荐）：以 infra-lab-bot GitHub App 身份自动换发 + 续期 installation token。
#   需要 App 已授予该仓库 Actions: read/write，并安装到本仓库。
#   INFRA_LAB_BOT_CLIENT_ID：App 的 Client ID（JWT 的 iss；GitHub 已弃用 App ID）。
#   私钥二选一：
#     INFRA_LAB_BOT_PRIVATE_KEY       —— PEM 内容（可用 \n 转义为单行）；或
#     INFRA_LAB_BOT_PRIVATE_KEY_PATH  —— 指向 .pem 文件的路径。
INFRA_LAB_BOT_CLIENT_ID=
INFRA_LAB_BOT_PRIVATE_KEY_PATH=
# INFRA_LAB_BOT_PRIVATE_KEY=
#
# 方式 B（兜底 / 本地快测）：直接给一枚能触发 workflow_dispatch 的静态 token
#   （classic PAT 带 repo+workflow，或细粒度 token 授予 Actions: read/write，或一枚
#   installation token）。配了它就跳过 App 换发。注意 installation token 约 1h 过期。
INFRA_LAB_BOT_GITHUB_TOKEN=

# ─── 接待 agent（fast-responder）的 LLM（自定义网关 / OpenAI-compatible 端点）───
# 仅用于挑 emoji + 写一句安抚 notice；不作答（实质处理已交给 infra-lab-bot）。
# 三个都配齐才跑 LLM；缺任一则降级到固定 notice + 直接派发（仍能跑通链路）。
# 注意 baseURL 要带兼容前缀（如 new-api 用 /v1），否则会打到网关首页拿到 HTML。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
