# Free-tier cloud deployment example.
# This is for managed services such as:
# - Web: Vercel Hobby
# - H5: Cloudflare Pages Free
# - API: Cloudflare Workers Free (primary), or Render/Koyeb Free (Docker fallback)
# - Postgres: Neon Free
# - Redis: Upstash Redis Free
#
# This file describes the Node/Docker API runtime (Render/Koyeb), which reads env vars
# and a redis:// URL. The Cloudflare Workers runtime does NOT use this file: it takes
# its config from apps/api/wrangler.toml [vars] + Worker secrets, and talks to Upstash
# over REST (UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN) instead of REDIS_URL.
# See docs/deployment.md and apps/api/README.md.
#
# Browser cookie auth requires the browser clients and API to be same-site.
# Use subdomains under one domain you control:
#   app.example.com, api.example.com, h5.example.com

NODE_ENV=production
PORT=3001

# Managed data services.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/app?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Public browser origins.
BETTER_AUTH_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
VITE_API_URL=https://api.example.com
TRUSTED_ORIGINS=https://h5.example.com

# Cookie/session guardrails.
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
OTP_DEBUG_RETURN_CODE=false

# Generate with `openssl rand -hex 32`; keep these different.
OTP_SECRET=replace-me-with-a-long-random-hex-string
BETTER_AUTH_SECRET=replace-me-with-another-long-random-hex-string

# API runtime tuning.
UPLOADS_DIR=/tmp/infra-lab-uploads
MAX_REQUEST_BODY_BYTES=10485760
SLOW_REQUEST_MS=1000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Optional APNS.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=
# APNS_PRIVATE_KEY_PATH=
# APNS_PRODUCTION=false
